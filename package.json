{
  "name": "codespaces-blank",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-picker/picker": "2.11.4",
    "axios": "^1.20.0",
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
